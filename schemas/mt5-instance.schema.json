{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mt5-instance/1",
  "title": "mt5-gateway instance configuration (non-secret)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "instance_name", "broker_label", "broker_server", "environment",
               "account_class", "image", "network", "ports", "data_volume", "limits",
               "timezone", "servers_dat", "secrets"],
  "properties": {
    "schema": {"const": "mt5-instance/1"},
    "instance_name": {"type": "string", "pattern": "^mt5-[a-z0-9]+-(demo|live)-[a-z0-9]{1,16}$"},
    "broker_label": {"type": "string", "pattern": "^[a-z0-9]{2,24}$"},
    "broker_server": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "environment": {"enum": ["DEMO", "LIVE"]},
    "account_class": {"enum": ["demo-unfunded", "demo-simulated-capital", "live-capital"]},
    "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+|@sha256:[0-9a-f]{64})$", "maxLength": 200},
    "restart": {"enum": ["no", "on-failure", "unless-stopped"]},
    "network": {
      "type": "object", "additionalProperties": false, "required": ["name", "bind"],
      "properties": {
        "name": {"type": "string", "pattern": "^mt5-[a-z0-9-]{3,60}$"},
        "bind": {"enum": ["127.0.0.1", "::1"]}
      }
    },
    "ports": {
      "type": "object", "additionalProperties": false, "required": ["operator_ui"],
      "properties": {
        "operator_ui": {"oneOf": [{"const": "none"}, {"type": "integer", "minimum": 1024, "maximum": 65535}]}
      }
    },
    "data_volume": {"type": "string", "pattern": "^mt5-[a-z0-9-]{3,60}$"},
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["memory_mb", "cpus", "pids"],
      "properties": {
        "memory_mb": {"type": "integer", "minimum": 512, "maximum": 16384},
        "cpus": {"type": "number", "minimum": 0.25, "maximum": 8},
        "pids": {"type": "integer", "minimum": 64, "maximum": 4096}
      }
    },
    "timezone": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_+/-]{1,40}$"},
    "servers_dat": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"},
    "log_level": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR"]},
    "secrets": {
      "type": "object", "additionalProperties": false, "required": ["dir"],
      "properties": {"dir": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"}}
    },
    "live": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enable": {"type": "boolean"},
        "capital_gate_marker": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"},
        "live_capable_build": {"type": "boolean"}
      }
    }
  }
}
